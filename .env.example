# Copy this file to .env and fill in your credentials
# NEVER commit .env to git

# Airtable
# Get token: https://airtable.com/create/tokens
# Get base ID: open your base in browser → URL starts with app...
AIRTABLE_TOKEN=pat_...
AIRTABLE_BASE_ID=app...

# Telegram
# Create a bot: message @BotFather on Telegram → /newbot
# Get chat ID: send a message to your bot, then call:
#   https://api.telegram.org/bot{TOKEN}/getUpdates
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...
